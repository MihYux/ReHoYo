{
  "name": "rehoyo-sender-agent",
  "version": "0.2.0",
  "description": "Employee-only market intelligence and regional pet-policy publishing agent.",
  "author": "MihYux",
  "private": true,
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently --kill-others --success first --names web,electron \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "next dev",
    "dev:headless": "next dev",
    "dev:electron": "wait-on http-get://127.0.0.1:3000 && electron electron/main.mjs",
    "build:icon": "python scripts/build-app-icon.py",
    "build": "next build",
    "build:server": "node scripts/clean-electron-build.mjs && next build && node scripts/prepare-electron-build.mjs",
    "dist": "npm run build:server && electron-builder --publish never",
    "dist:win": "npm run build:server && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build:server && electron-builder --mac dmg --publish never",
    "dist:mac:x64": "npm run build:server && electron-builder --mac dmg --x64 --publish never",
    "dist:mac:arm64": "npm run build:server && electron-builder --mac dmg --arm64 --publish never",
    "smoke:packaged-server": "node scripts/smoke-packaged-server.mjs",
    "smoke:packaged-app": "node scripts/smoke-packaged-app.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "node scripts/live-ai-smoke.mjs",
    "test:search-providers:live": "vitest run --config vitest.search-live.config.ts",
    "cache:seed:hsr2": "node scripts/seed-hsr2-evidence-cache.mjs",
    "cache:verify:hsr2": "node scripts/verify-hsr2-evidence-cache.mjs",
    "test:plan-agent:live": "vitest run --config vitest.live.config.ts",
    "test:ui:headless": "python scripts/headless-ui-smoke.py",
    "test:regions:headless": "python scripts/headless-regions-smoke.py",
    "test:regions:live-ui": "python scripts/headless-regions-live.py",
    "test:plan:headless": "python scripts/headless-plan-agent.py"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "@phosphor-icons/react": "^2.1.10",
    "d3-force": "^3.0.0",
    "drizzle-orm": "^0.45.2",
    "mammoth": "^1.12.0",
    "next": "^16.2.11",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "read-excel-file": "^9.3.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.1.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.4",
    "wrangler": "^4.114.0"
  },
  "build": {
    "appId": "com.rehoyo.sender-agent",
    "productName": "ReHoYo Sender Agent",
    "artifactName": "ReHoYo-Sender-Agent-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".packaging/server",
        "to": "app-server"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/app-icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/app-icon.png",
      "category": "public.app-category.productivity",
      "identity": null
    }
  },
  "overrides": {
    "postcss": "8.5.12",
    "sharp": "0.35.0"
  }
}
